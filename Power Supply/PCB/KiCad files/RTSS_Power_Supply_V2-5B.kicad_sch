	(text "U5"
		(exclude_from_sim no)
		(at 224.282 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "01f3e904-5a02-46b2-bf83-c3db35167a73")
	)
	(text "RF section"
		(exclude_from_sim no)
		(at 186.944 102.108 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "0a58e952-a302-4744-9c42-3a6dc69f9504")
	)
	(text "Note: 7.6MHz xtal is preferred\n7.68MHz is acceptable as a substitute, \nbut is outside of the 472-479kHz band.\n\n7.6MHz xtal yields 475kHz on OSC\n7.68MHz xtal yields 480kHz on OSC"
		(exclude_from_sim no)
		(at 128.27 88.392 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "36809a18-e1c0-47e0-8c76-9b8add1ba48e")
	)
	(text "Cut and solder to JP1 for external\nenable control of the oscillator"
		(exclude_from_sim no)
		(at 198.374 62.738 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3acdb5e3-490a-4d42-bb6a-14917bc78be0")
	)
	(text "Gate driver"
		(exclude_from_sim no)
		(at 27.686 100.584 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "4d6ac222-2985-491f-b719-c89e96d7f615")
	)
	(text "All capacitors in the RF section should be rated for at least 200V and be Class I (i.e. C0G/NP0).\nInductors L2-L5 should be wound on Kool Mu 0077932A7 cores using 22AWG or larger magnet wire.\nApproximate number of inductor turns: L2 = 14, L3 = 23, L4 = 23, L5 = 19 \nMeasure inductances at 475kHz on a VNA or at least 100kHz on a LCR. Try to be within ±0.2uH.\nWhen tuning the inductors, make the coils closer together to increase inductance, or futher apart to decrease.\nL1 sees primarily DC current and is tolerant to variation in indcutance, hence it can be an SMD inductor."
		(exclude_from_sim no)
		(at 90.932 151.892 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6241b843-9a9b-429d-9460-b1b4f500c869")
	)
	(text "PE"
		(exclude_from_sim no)
		(at 262.89 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "68ad578b-a8c4-4c08-a7ba-2bfdc5f5ce21")
	)
