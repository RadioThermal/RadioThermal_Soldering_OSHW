	(text "General Notes"
		(exclude_from_sim no)
		(at 30.48 163.83 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "b5d662b7-d9c2-4462-a563-f452070b4139")
	)
	(text "Note: External (not on board) barrel jack and switch are used.\nD1 can be used for a diode for RPP, thermistor for inrush\ncurrent limiting, for a fuse, or simply jumpered closed."
		(exclude_from_sim no)
		(at 17.018 57.658 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cbc7ed8e-cbd8-4e9f-80d3-3c2434f7550d")
	)
	(text "- 10µF capacitors outside of the RF section can be Class II MLCCs (X5R or X7R).\n- 10µF is the specified capacitance at 0V DC. It is fine for the capacitance with applied DC voltage to be under 10µF.\n\n- Oscillator frequency should ideally be within the 472-479kHz band, centered on 475kHz."
		(exclude_from_sim no)
		(at 16.51 170.434 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d2c9bd32-6b9b-4e4d-859d-645b496e4d5a")
	)
	(text "Optional shunts for current measurement.\nRequires cutting traces."
		(exclude_from_sim no)
		(at 260.604 148.59 0)
		(effects
