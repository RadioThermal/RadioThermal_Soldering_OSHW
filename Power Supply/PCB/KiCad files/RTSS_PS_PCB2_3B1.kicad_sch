	(text "Gate driver"
		(exclude_from_sim no)
		(at 27.686 100.584 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "4d6ac222-2985-491f-b719-c89e96d7f615")
	)
	(text "- All capacitors in the RF section should be rated for at least 200V and be C0G.\n- Inductors L2-L5 should be wound on Kool Mu 0077932A7 cores using 22AWG or larger magnet wire.\n- Inductor L2 requires two stacked Kool Mu 0077932A7 cores.\n- Measure inductances at 470Khz on a VNA or 100KHz on a LCR, try to be within 0.2uH.\n- L1 sees primarily DC current and is tolerant to variation in indcutance—it can can be purchased pre-wound."
		(exclude_from_sim no)
		(at 90.17 151.638 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6241b843-9a9b-429d-9460-b1b4f500c869")
	)
	(text "Power input\n"
		(exclude_from_sim no)
		(at 59.182 22.606 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
		)
		(uuid "6b7372a3-d4fb-4981-85f3-cae17ee3142e")
	)
