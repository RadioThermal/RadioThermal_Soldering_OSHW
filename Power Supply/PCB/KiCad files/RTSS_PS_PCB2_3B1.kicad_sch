		(uuid "36809a18-e1c0-47e0-8c76-9b8add1ba48e")
	)
	(text "Misc Hardware"
		(exclude_from_sim no)
		(at 43.18 159.258 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
